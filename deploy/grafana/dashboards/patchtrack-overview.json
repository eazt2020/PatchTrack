          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "patchtrack-postgres"
          },
          "rawSql": "\nSELECT\n    COALESCE(NULLIF(a.business_group, ''), 'UNKNOWN') AS \"Business service\",\n    count(*) FILTER (WHERE c.state = 'compliant')     AS \"Compliant\",\n    count(*) FILTER (WHERE c.state = 'non_compliant') AS \"Non-compliant\",\n    count(*) FILTER (WHERE c.state IN ('unknown','stale')) AS \"Unknown / stale\"\nFROM compliance.asset_compliance c\nJOIN inventory.asset_effective a ON a.id = c.asset_id\nWHERE a.in_scope AND a.lifecycle_status = 'active'\n  AND ('$os_family' = '__all__' OR a.os_family = '$os_family')\n  AND ('$environment' = '__all__' OR a.environment = '$environment')\n  AND ('$business_group' = '__all__' OR a.business_group = '$business_group')\nGROUP BY 1\nORDER BY 2 + 3 + 4 DESC\nLIMIT 10\n",
