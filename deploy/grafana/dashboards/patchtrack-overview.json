  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total servers (in scope)",
      "description": "Active, in-scope assets. Excluded assets are reported separately.",
      "datasource": {
        "type": "postgres",
        "uid": "patchtrack-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "patchtrack-postgres"
          },
          "rawSql": "SELECT compliant + non_compliant + unknown_stale + excluded AS value\nFROM (\n    SELECT\n        count(*) FILTER (WHERE state = 'compliant') AS compliant,\n        count(*) FILTER (WHERE state = 'non_compliant') AS non_compliant,\n        count(*) FILTER (WHERE state IN ('compliant','non_compliant','unknown','stale')) AS denominator,\n        count(*) FILTER (WHERE state IN ('unknown','stale')) AS unknown_stale,\n        count(*) FILTER (WHERE state = 'excluded') AS excluded\n    FROM compliance.asset_compliance c\n    JOIN inventory.asset_effective a ON a.id = c.asset_id\n    WHERE a.in_scope AND a.lifecycle_status = 'active'\n      AND ('$os_family' = '__all__' OR a.os_family = '$os_family')\n      AND ('$environment' = '__all__' OR a.environment = '$environment')\n      AND ('$business_group' = '__all__' OR a.business_group = '$business_group')\n) s",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
