    {
      "id": 14,
      "type": "barchart",
      "title": "Outstanding findings by severity",
      "description": "Patch-level metric. Kept separate from the server-level compliance percentage; the two are never blended.",
      "datasource": {
        "type": "postgres",
        "uid": "patchtrack-postgres"
      },
      "gridPos": {
