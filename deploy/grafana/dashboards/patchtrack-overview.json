      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "patchtrack-postgres"
          },
          "rawSql": "\nSELECT\n    f.severity AS \"Severity\",\n    count(*) AS \"Findings\"\nFROM compliance.findings f\nJOIN compliance.asset_latest_assessment la ON la.assessment_id = f.assessment_id\nJOIN inventory.asset_effective a ON a.id = f.asset_id\nWHERE a.in_scope\nGROUP BY 1\nORDER BY CASE f.severity WHEN 'critical' THEN 0 WHEN 'important' THEN 1\n         WHEN 'moderate' THEN 2 WHEN 'low' THEN 3 ELSE 4 END\n",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
