    {
      "id": 17,
      "type": "table",
      "title": "Top non-compliant servers",
      "description": "Remediation is performed in the authoritative patch system; PatchTrack records status only.",
      "datasource": {
        "type": "postgres",
        "uid": "patchtrack-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "patchtrack-postgres"
          },
          "rawSql": "\nSELECT\n    a.hostname              AS \"Hostname\",\n    host(a.ip_address)      AS \"IP address\",\n    a.os_name || ' ' || a.os_version AS \"Operating system\",\n    a.environment           AS \"Environment\",\n    a.business_group        AS \"Business service\",\n    c.state                 AS \"Status\",\n    c.total_patches         AS \"Missing patches\",\n    c.critical_count        AS \"Critical\",\n    to_char(asmt.assessed_at, 'YYYY-MM-DD HH24:MI') AS \"Last assessed\"\nFROM inventory.asset_effective a\nJOIN compliance.asset_compliance c ON c.asset_id = a.id\nLEFT JOIN compliance.asset_latest_assessment la ON la.asset_id = a.id\nLEFT JOIN compliance.assessments asmt ON asmt.id = la.assessment_id\nWHERE a.in_scope AND c.state = 'non_compliant'\n  AND ('$os_family' = '__all__' OR a.os_family = '$os_family')\n  AND ('$environment' = '__all__' OR a.environment = '$environment')\n  AND ('$business_group' = '__all__' OR a.business_group = '$business_group')\nORDER BY c.total_patches DESC NULLS LAST, a.hostname\nLIMIT 15\n",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "countRows": false,
          "fields": ""
        },
        "sortBy": [
          {
            "displayName": "Missing patches",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "non_compliant": {
                        "text": "Non-compliant",
                        "color": "#d03b3b",
                        "index": 0
                      },
                      "compliant": {
                        "text": "Compliant",
                        "color": "#0ca30c",
                        "index": 1
                      },
                      "unknown": {
                        "text": "Unknown",
                        "color": "#fab219",
                        "index": 2
                      },
                      "stale": {
                        "text": "Stale",
                        "color": "#7f8b98",
                        "index": 3
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 18,
      "type": "table",
      "title": "Collection health",
      "description": "A failed collection does not delete inventory and does not classify anything as compliant.",
      "datasource": {
        "type": "postgres",
        "uid": "patchtrack-postgres"
      },
      "gridPos": {
        "x": 16,
        "y": 29,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "patchtrack-postgres"
          },
          "rawSql": "\nSELECT\n    i.key AS \"Integration\",\n    r.status AS \"Status\",\n    to_char(r.started_at, 'YYYY-MM-DD HH24:MI') AS \"Last attempt\",\n    to_char(r.finished_at, 'YYYY-MM-DD HH24:MI') AS \"Finished\",\n    r.records_seen AS \"Seen\",\n    r.records_updated AS \"Matched\",\n    r.records_rejected AS \"Rejected\",\n    r.assets_unmatched AS \"Unmatched\",\n    CASE WHEN r.status = 'failed' THEN left(r.error_summary, 80) ELSE '' END AS \"Error\"\nFROM inventory.integrations i\nLEFT JOIN LATERAL (\n    SELECT * FROM inventory.sync_runs s\n    WHERE s.integration_key = i.key\n    ORDER BY s.started_at DESC LIMIT 1\n) r ON TRUE\nORDER BY i.key\n",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "countRows": false,
          "fields": ""
        },
        "sortBy": [
          {
            "displayName": "Missing patches",
            "desc": true
          }
        ]
