    {
      "id": 15,
      "type": "timeseries",
      "title": "Monthly compliance trend",
      "description": "Derived from immutable daily snapshots. The dashed threshold is the active policy target.",
      "datasource": {
        "type": "postgres",
        "uid": "patchtrack-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "patchtrack-postgres"
          },
          "rawSql": "\nSELECT\n    date_trunc('month', period_start)::date AS \"time\",\n    avg(compliance_pct)::numeric(6,2) AS \"Compliance\",\n    avg(target_pct)::numeric(6,2) AS \"Target\"\nFROM compliance.snapshots\nWHERE scope = 'daily'\n  AND period_start >= (date_trunc('month', now()) - interval '11 months')::date\nGROUP BY 1\nORDER BY 1\n",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
