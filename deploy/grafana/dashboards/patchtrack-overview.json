    {
      "id": 10,
      "type": "barchart",
      "title": "Compliance by operating system",
      "description": "",
      "datasource": {
        "type": "postgres",
        "uid": "patchtrack-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "patchtrack-postgres"
          },
          "rawSql": "\nSELECT\n    COALESCE(NULLIF(a.os_family || ' ' || a.os_version, ''), 'UNKNOWN') AS \"Operating system\",\n    count(*) FILTER (WHERE c.state = 'compliant')     AS \"Compliant\",\n    count(*) FILTER (WHERE c.state = 'non_compliant') AS \"Non-compliant\",\n    count(*) FILTER (WHERE c.state IN ('unknown','stale')) AS \"Unknown / stale\"\nFROM compliance.asset_compliance c\nJOIN inventory.asset_effective a ON a.id = c.asset_id\nWHERE a.in_scope AND a.lifecycle_status = 'active'\n  AND ('$os_family' = '__all__' OR a.os_family = '$os_family')\n  AND ('$environment' = '__all__' OR a.environment = '$environment')\n  AND ('$business_group' = '__all__' OR a.business_group = '$business_group')\nGROUP BY 1\nORDER BY 2 + 3 + 4 DESC\nLIMIT 12\n",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "options": {
        "xField": "Operating system",
        "orientation": "vertical",
        "stacking": "normal",
        "showValue": "auto",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
