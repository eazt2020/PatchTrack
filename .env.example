# PatchTrack deployment template.
#
# Copy to .env, then fill in every value marked CHANGE_ME. The file is read by
# docker compose and by the services (pydantic-settings reads .env). It must be
# mode 0600 and owned by the deployment user:
#
#   install -m 0600 .env.example /etc/patchtrack/.env   # then edit
#
# Never commit the filled-in file. Generate secrets with:
#   openssl rand -hex 32
#
# No value below is a working default: the services refuse to start if the
# JWT secret or service token is missing or too short.

# ---------------------------------------------------------------- application
PATCHTRACK_ENVIRONMENT=production
# Secure flag on the session and CSRF cookies. Leave as 'auto': cookies are
# marked Secure for every non-loopback host, so a plain-HTTP deployment cannot
# hold a session. 'never' is development-only and the service refuses to start
# with it when PATCHTRACK_ENVIRONMENT=production.
PATCHTRACK_SESSION_COOKIE_SECURE=auto
# Lowercase: uvicorn accepts critical|error|warning|info|debug|trace. The
# container entrypoint lowercases the value, the native unit does not.
PATCHTRACK_LOG_LEVEL=info

# Optional: Prometheus image and listen port for the `monitoring` profile.
# PROMETHEUS_IMAGE=docker.io/prom/prometheus:v3.15.1
# PATCHTRACK_PROMETHEUS_PORT=9090

# ---------------------------------------------------------------- database
# Password must match POSTGRES_PASSWORD. Use a dedicated role; do not run the
# application as the postgres superuser.
POSTGRES_DB=patchtrack
POSTGRES_USER=patchtrack
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_32
# Optional: substitute the database image. The default,
# docker.io/library/postgres:17, pulls without an account. Red Hat's image is
# registry.redhat.io/rhel9/postgresql-17 and needs a subscription and a terms
# acceptance; with it, also set POSTGRES_DATA_DIR=/var/lib/pgsql/data.
# POSTGRES_IMAGE=docker.io/library/postgres:17
# POSTGRES_DATA_DIR=/var/lib/postgresql/data
# The bundled postgres image does not enable TLS by default, so the default
# URL uses 'prefer': it negotiates TLS when the server offers it and otherwise
# uses the private Compose bridge. The database publishes no host port. For an
# external PostgreSQL service use 'require' at minimum, and 'verify-full' where
# the server certificate is verifiable; 'disable' is never supported.
PATCHTRACK_DATABASE_URL=postgresql+psycopg://patchtrack:CHANGE_ME_openssl_rand_hex_32@postgres:5432/patchtrack?sslmode=prefer
PATCHTRACK_DB_POOL_SIZE=5
PATCHTRACK_DB_POOL_MAX_OVERFLOW=5

# ---------------------------------------------------------------- secrets
# 32+ bytes of hex. Rotating this invalidates all access tokens; users simply
# sign in again. Rotate both on a schedule and after any suspected exposure.
PATCHTRACK_JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
# Shared bearer token for service-to-service calls made through the gateway, and
# by the optional manual job runner (scripts/patchtrack-job.sh). Scheduled work
# runs inside each service and needs no token.
PATCHTRACK_SERVICE_TOKEN=CHANGE_ME_openssl_rand_hex_32
# Optional separate key for credentials saved through the UI (currently only the
# SMTP password). Falls back to the JWT secret when unset. Set a distinct value
# so rotating the JWT secret does not make the saved SMTP password unreadable;
# if either key changes, re-enter the password in Settings -> Email delivery.
# PATCHTRACK_SECRETS_KEY=CHANGE_ME_openssl_rand_hex_32
#
# Secret files (recommended for production). Instead of storing a credential
# in this file, point its *_FILE variable at a mounted file. The file value
# wins over the plain variable; remove the plain one once the deployment is
# verified, so it is no longer passed into every container's environment.
# The files should be mode 0600 (or 0640 root:patchtrack for Compose secrets)
# and supplied by a systemd credential or secret manager where available. See
# docs/security.md and docker-compose.secrets.yml.
# PATCHTRACK_DATABASE_URL_FILE=/run/secrets/database_url
# PATCHTRACK_JWT_SECRET_FILE=/run/secrets/jwt_secret
# PATCHTRACK_SERVICE_TOKEN_FILE=/run/secrets/service_token
# PATCHTRACK_SECRETS_KEY_FILE=/run/secrets/secrets_key
# PATCHTRACK_SMTP_PASSWORD_FILE=/run/secrets/smtp_password

# Largest accepted request body, in bytes. Evidence attachments arrive
# base64-encoded inside a JSON request; 64 MiB comfortably covers the maximum
# five attachments. Bodies above this are refused with 413.
PATCHTRACK_MAX_REQUEST_BYTES=67108864

# ---------------------------------------------------------------- reporting
PATCHTRACK_REPORT_DIR=/var/lib/patchtrack/reports
# Default only: administrators change the live window in Settings -> Report
# file retention, which applies without a restart. 2555 days = 7 years. Only the
# PDF is deleted; the report row and digest remain.
PATCHTRACK_REPORT_RETENTION_DAYS=2555

# SMTP is optional. The relay is normally configured in Settings -> Email
# delivery by an administrator, which applies without a restart and encrypts
# the password at rest. The values below are only the fallback used until a
# relay is saved there; leaving smtp_host empty disables delivery, and reports
# are still generated and downloadable. A failed send never invalidates a
# report.
PATCHTRACK_SMTP_HOST=
PATCHTRACK_SMTP_PORT=587
PATCHTRACK_SMTP_USERNAME=
PATCHTRACK_SMTP_PASSWORD=
PATCHTRACK_SMTP_STARTTLS=true
PATCHTRACK_SMTP_SENDER=patchtrack@example.invalid

# ---------------------------------------------------------------- scheduler
# Scheduled work runs inside each service (inventory collects, compliance takes
# the daily snapshot, reporting evaluates schedules, identity purges the audit
# trail). No systemd timer or cron entry is needed. Set enabled=false only to
# pause all scheduled work, for example during a data migration.
PATCHTRACK_SCHEDULER_ENABLED=true
PATCHTRACK_SCHEDULER_POLL_SECONDS=15
# A failed job is retried after this many seconds instead of waiting for its
# full interval, so a transient source-system outage recovers quickly.
PATCHTRACK_SCHEDULER_RETRY_SECONDS=300
# Delay before the first pass, giving the service time to finish starting.
PATCHTRACK_SCHEDULER_STARTUP_DELAY_SECONDS=10
# Collection intervals, in seconds. These are initial defaults: once a job has
# run, administrators edit it at Reporting -> Schedules -> System jobs and the
# stored value takes precedence.
PATCHTRACK_SYNC_ASSETEXPLORER_INTERVAL=21600
PATCHTRACK_SYNC_SATELLITE_INTERVAL=21600
PATCHTRACK_SYNC_SCCM_INTERVAL=86400
PATCHTRACK_SYNC_SOLARIS_INTERVAL=604800
PATCHTRACK_DAILY_SNAPSHOT_INTERVAL=86400
PATCHTRACK_AUDIT_PURGE_INTERVAL=86400
PATCHTRACK_REPORT_TICK_INTERVAL=60
# Report-file retention is a filesystem sweep, so it runs daily rather than on
# every tick.
PATCHTRACK_REPORT_PURGE_INTERVAL=86400

# ---------------------------------------------------------------- collectors
# Solaris collection is an approved read-only file drop; direct SSH is NOT used.
PATCHTRACK_SOLARIS_INBOX=/var/lib/patchtrack/solaris-inbox

# ---------------------------------------------------------------- network
# Bind address for the published ports. 127.0.0.1 keeps the stack on the host.
# With PATCHTRACK_TLS_ENABLED=true (below) the gateway itself serves HTTPS, so
# the browser uses https://<host>:8005. Set 0.0.0.0 only when the gateway is
# exposed directly; otherwise keep it on loopback behind a proxy.
PATCHTRACK_BIND_ADDRESS=127.0.0.1
PATCHTRACK_GATEWAY_PORT=8005
PATCHTRACK_GRAFANA_PORT=3000

# ---------------------------------------------------------------- TLS
# The gateway terminates TLS itself. On first start it generates a self-signed
# certificate for this host under the tls volume, so a new installation never
# serves the sign-in page over plain HTTP. Browsers warn until an administrator
# uploads the organisation's certificate at Settings -> HTTPS certificate; that
# takes effect on new connections without a restart.
#
# Set false when an external reverse proxy terminates TLS (see
# docs/configuration.md); the gateway then speaks HTTP on its port as before.
PATCHTRACK_TLS_ENABLED=true
# DNS name in the generated certificate. Leave empty to use the host's name.
# PATCHTRACK_TLS_HOSTNAME=patchtrack.example.com
# Certificate and key locations. Relative names resolve under tls_dir; the
# defaults are server.crt and server.key there.
PATCHTRACK_TLS_DIR=/var/lib/patchtrack/tls
# PATCHTRACK_TLS_CERT_FILE=server.crt
# PATCHTRACK_TLS_KEY_FILE=server.key

# Comma-separated hosts trusted to send X-Forwarded-* headers. Never "*".
# With direct gateway TLS, only the gateway's own listeners matter here; when
# a proxy terminates TLS, this is the proxy's address on this host.
PATCHTRACK_FORWARDED_IPS=127.0.0.1

# The four backend services accept connections only from the compose network
# and take the caller's address from the gateway's X-Forwarded-For. This must
# cover that network's addresses (compose's default bridge is 172.17.0.0/16,
# user-defined networks are drawn from 172.16.0.0/12). Never "*".
PATCHTRACK_INTERNAL_FORWARDED_IPS=172.16.0.0/12

# ---------------------------------------------------------------- grafana
# Read-only database role (deploy/postgres/roles/010_grafana_readonly.sql).
PATCHTRACK_GF_DB_HOST=postgres
PATCHTRACK_GF_DB_PORT=5432
PATCHTRACK_GF_DB_NAME=patchtrack
PATCHTRACK_GF_DB_USER=patchtrack_grafana
PATCHTRACK_GF_DB_PASSWORD=CHANGE_ME_openssl_rand_base64_32
# require | verify-ca | verify-full. Never "disable" in production.
PATCHTRACK_GF_DB_SSLMODE=verify-full
GF_ADMIN_PASSWORD=CHANGE_ME_openssl_rand_base64_32
GF_SERVER_ROOT_URL=http://127.0.0.1:3000

# ---------------------------------------------------------------- bootstrap
# There is deliberately no bootstrap password here. On a fresh database the
# login page shows a one-time "create administrator" form; that account is
# forced to change its password at first sign-in, and the form disappears once
# a user exists. Nothing universal is ever shipped.
#
# Keep this empty when provisioning administrators through the enterprise IdP.
